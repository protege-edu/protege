# Protégé settings. Copy this file to "protege.env" (same folder) and change what you need.
# Lines starting with # are ignored.

# The port Protégé listens on (students' address ends with it)
# PORT=3000

# Your tunnel's fixed https address, if you put Protégé online (see the guide)
# (Start Protégé online opens a free Cloudflare quick tunnel by itself. A school with its own fixed address,
#  e.g. a Tailscale Funnel, puts it here instead.)
# PUBLIC_URL=https://your-laptop.your-tailnet.ts.net

# Gloam's AI model in Ollama (a bigger one is smarter but slower)
# AI_MODEL=qwen3:4b-instruct

# How many students the AI answers at once (raise it on a laptop with a strong graphics card)
# AI_CONCURRENCY=2

# "Continue with Google": your free Google Cloud project's keys (see the guide)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# School IT that installs Ollama and the model itself: Protégé never installs or downloads anything at start
# PROTEGE_SETUP=off

// Protégé on Cloudflare: the app (a Worker built by OpenNext from the Next.js app) and its database (D1).
// Every hosting setting lives here and in open-next.config.ts, so a move somewhere else stays contained.
// Secrets (the Claude API key, the owner's setup code) are NOT in this file: `npx wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protege",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "protege",
      // the real id comes from `npx wrangler d1 create protege` (any value works for the local copy)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // lessons waiting to be drafted: one at a time, tried again (twice) if a draft is cut off
  "queues": {
    "producers": [{ "binding": "DRAFTS", "queue": "protege-drafts" }],
    "consumers": [{ "queue": "protege-drafts", "max_batch_size": 1, "max_retries": 2 }]
  },
  // the daily clean-up (lib/privacy/sweep.ts), at 3:17 in the morning, Toronto time
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true }
}

{
  "name": "protege",
  "version": "0.2.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Students teach Gloam, a confused, funny companion, and learn by explaining. Runs on one school laptop, with local AI.",
  "homepage": "https://protege-edu.pages.dev",
  "repository": "github:protege-edu/protege",
  "bugs": "https://github.com/protege-edu/protege/issues",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/companion-eval.ts",
    "screenshots": "tsx scripts/screenshot.ts",
    "test:logic": "tsx scripts/check-logic.ts",
    "test:accounts": "tsx --conditions=react-server scripts/check-accounts.ts",
    "reset-teacher": "tsx --conditions=react-server scripts/admin.ts reset-teacher",
    "load-test": "tsx scripts/load-test.ts",
    "class": "tsx scripts/class.ts",
    "voice:setup": "tsx scripts/voice-setup.ts",
    "voice": "tsx scripts/voice.ts",
    "restore": "tsx --conditions=react-server scripts/admin.ts restore",
    "licenses": "tsx scripts/licenses.ts",
    "release": "tsx scripts/release.ts",
    "access-log": "tsx --conditions=react-server scripts/admin.ts access-log",
    "site": "tsx scripts/site.ts",
    "site:check": "tsx scripts/site-check.ts"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",

    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "marked": "^15.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }

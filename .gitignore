# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-release/
/release/
/site-dist/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data/

# playwright
/test-results/
/playwright-report/
/screenshots/

!.env.example
art/__pycache__/

# throwaway helper scripts
/scripts/_*

# Cloudflare: the local copy of the database and other dev state, and the built worker
.wrangler/
.open-next/
.dev.vars*

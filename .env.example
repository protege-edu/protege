# Copy this to .env and fill in what you need. Online (Vercel), set the same names under Environment Variables.

# Gloam's brain: a Claude API key (from the Anthropic Console). Server only: never sent to a browser.
ANTHROPIC_API_KEY=
# The model (default: Claude Haiku 5.5)
# AI_MODEL=claude-haiku-5-5

# The database online (Turso). Leave out while developing: a file on this computer is used instead.
# TURSO_DATABASE_URL=libsql://protege-yourname.aws-us-east-1.turso.io
# TURSO_AUTH_TOKEN=

# Protects the daily clean-up that Vercel runs (any long random password)
# CRON_SECRET=

# Daily limits on Gloam's brain (see README, "Daily limits")
# AI_DAILY_PER_STUDENT=300
# AI_DAILY_PER_CLASS=3000
# AI_DAILY_DRAFTS_PER_TEACHER=40
# AI_DAILY_TOTAL=20000

# Optional: "Continue with Google" (see README, "Google sign-in"). Needs both.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: the app's address, when it isn't on Vercel (Vercel knows it by itself)
# PROTEGE_APP_URL=https://protege-edu.vercel.app

# Copy this to .env.local and change what you need. Everything is free and local.

# The AI (any OpenAI-compatible server; Ollama by default)
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:4b-instruct

# Optional: where the database lives (default: %LOCALAPPDATA%\Protege on Windows)
# PROTEGE_DATA_DIR=

# Optional: "Continue with Google" (see README, "Google sign-in"). Needs all three.
# PUBLIC_URL=https://your-laptop.your-tailnet.ts.net
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# How many AI calls run at once (the rest wait in line). Measure with npm run load-test.
# AI_CONCURRENCY=2

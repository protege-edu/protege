import { chromium } from "@playwright/test";
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 1366, height: 768 } });
const p = await ctx.newPage();
const errs: string[] = [];
p.on("pageerror", (e) => errs.push(e.message.slice(0, 200)));
p.on("console", (m) => m.type() === "error" && errs.push(m.text().slice(0, 200)));
await p.goto("http://localhost:3100/teacher", { waitUntil: "load" });
await p.waitForTimeout(2500);
await p.screenshot({ path: "screenshots/teacher-signin.png" });
await p.getByLabel("Passcode").fill("test-1234");
await p.getByRole("button", { name: /sign in|save passcode/i }).click();
await p.waitForTimeout(2500);
await p.screenshot({ path: "screenshots/teacher-home.png", fullPage: true });
await p.getByRole("link", { name: "Open dashboard" }).first().click();
await p.waitForTimeout(3500);
await p.screenshot({ path: "screenshots/teacher-dashboard.png", fullPage: true });
await p.getByRole("button", { name: "Quiet Owl" }).click();
await p.waitForTimeout(1500);
await p.screenshot({ path: "screenshots/teacher-transcript.png" });
console.log(errs.slice(0, 4).join("\n") || "no errors");
await b.close();

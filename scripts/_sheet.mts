import { chromium } from "@playwright/test";
const b = await chromium.launch();
const p = await b.newPage({ viewport: { width: 1500, height: 1100 } });
const errs: string[] = [];
p.on("pageerror", (e) => errs.push(e.message));
p.on("console", (m) => m.type() === "error" && errs.push(m.text()));
await p.goto("http://localhost:3100/dev/gloam", { waitUntil: "load" });
await p.waitForTimeout(3500);
await p.screenshot({ path: "screenshots/sheet.png", fullPage: true });
await p.locator("figure").nth(1).screenshot({ path: "screenshots/sheet-proud-0.png" });
await p.locator("figure").nth(11 + 7).screenshot({ path: "screenshots/sheet-eureka-04.png" });
await p.locator("figure").nth(22 + 1).screenshot({ path: "screenshots/sheet-proud-1.png" });
console.log(errs.slice(0, 3).join("\n") || "no errors");
await b.close();
